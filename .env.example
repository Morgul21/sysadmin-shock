# Provider: ollama | openai | anthropic | google
# ollama gira in locale e non chiede API key (vedi ollama/Modelfile.8b)
LLM_PROVIDER=ollama
# Default: breakfix-qwen3-8b. È ibrido e ragiona prima di ogni risposta (29 s per una riga su CPU):
# "none" spegne il ragionamento (5 s). Vale per tutti i modelli usati, giudice compreso.
LLM_REASONING_EFFORT=none
# LLM_MODEL=breakfix-qwen3-8b
# OLLAMA_BASE_URL=http://localhost:11434/v1
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# Alternativa più leggera, ma meno affidabile come tutor (vedi ollama/Modelfile):
# LLM_MODEL=breakfix-qwen3

# Un server vLLM (o altro endpoint compatibile OpenAI) si usa come Ollama, cambiando URL e modello:
# OLLAMA_BASE_URL=http://<host>:8000/v1
# LLM_MODEL=<nome servito>

# Giudice di breakfix-tutor-eval: l'8B supera la calibrazione, il 4B no (vedi README, Eval del tutor)
JUDGE_PROVIDER=ollama
JUDGE_MODEL=breakfix-qwen3-8b
